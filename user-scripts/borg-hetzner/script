#!/bin/bash
# =============================================================================
# Unraid: borg (DOCKER) -> Hetzner Storage Box (SSH/borg protocol, port 23)
#
#   daily  : pg_dump immich + paperless SQLite snapshot (host-side, online)
#            + docker appdata configs + /boot/config (flash) + paperless db snapshot
#   weekly : immich original photos + paperless media (PDFs) (Sunday) + borg check
#
# borgbackup/borg is one-shot (runs a command, exits): User Scripts calls
# `docker run --rm`. Schedule: Community Apps -> User Scripts, daily 03:00.
#
# Host prep (run once as root):
#   mkdir -p /mnt/user/appdata/borg/ssh /mnt/user/appdata/borg/cache /mnt/user/system/borg/dumps
#   chmod 700 /mnt/user/appdata/borg/ssh
#   ssh-keygen -t ed25519 -f /mnt/user/appdata/borg/ssh/id_ed25519 -N "" -C unraid-borg
#   chmod 600 /mnt/user/appdata/borg/ssh/id_ed25519
#   openssl rand -base64 32 > /mnt/user/appdata/borg/borg.passphrase
#   chmod 600 /mnt/user/appdata/borg/borg.passphrase
#   -> upload id_ed25519.pub in Hetzner Console (Storage Box -> SSH keys)
#   -> build the borg image (borgbackup/borg has NO ssh client - borg needs one):
#      mkdir -p /mnt/user/appdata/borg/image
#      printf 'FROM alpine:3.22\nRUN apk add --no-cache borgbackup openssh-client\nENTRYPOINT ["borg"]\n' \
#        > /mnt/user/appdata/borg/image/Dockerfile
#      docker build -t borg-ssh:latest /mnt/user/appdata/borg/image
#   -> create /mnt/user/appdata/borg/backup.conf from the repo's
#      borg/backup.conf.example and fill in YOUR values (NEVER commit it!)
#
# The repo is auto-initialized on the first run (borg init --encryption=repokey-blake2).
# =============================================================================
set -euo pipefail

# ------------------------------- CONFIG --------------------------------------
SB_USER="u123456"                          # Storage Box user (or sub-account u123456_sub1)
SB_HOST="u123456.your-storagebox.de"
IMAGE="borg-ssh:latest"                  # locally built (see header): borg + openssh-client

RDIR="/mnt/user/appdata/borg"              # host: passphrase, ssh/, exclude, cache
PASSFILE="$RDIR/borg.passphrase"
APPDATA="/mnt/user/appdata"
DUMP_DIR="/mnt/user/system/borg/dumps"

IMMICH_DB_CONTAINER="immich_postgres"      # verify: docker ps | grep -i postgres
IMMICH_DB_USER="immich"                   # immich v2 default (v1: postgres)
# immich ORIGINALS live here (HOST path). Find it:
#   docker inspect -f '{{range .Mounts}}{{println .Source " -> " .Destination}}{{end}}' immich-server
#   docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' immich-server | grep -i upload
IMMICH_LIBRARY="/mnt/user/appdata/immich/upload"

# paperless-ngx WITHOUT postgres = SQLite. Back up the DB as an online
# snapshot (container's python sqlite3, no downtime) + the media dir weekly.
# Restore: put db.sqlite3 + media back - no manifest/importer needed.
PAPERLESS_CONTAINER="paperless-ngx"                                 # docker ps
PAPERLESS_DB_CONTAINER_PATH="/usr/src/paperless/data/db.sqlite3"    # container-side SQLite file
PAPERLESS_EXPORT_CONTAINER_PATH="/usr/src/paperless/export"         # container-side dir (your mapping!)
PAPERLESS_EXPORT_HOST_DIR="/mnt/user/data/private/paperless/export" # matching host bind mount!
PAPERLESS_MEDIA_HOST="/mnt/user/data/private/paperless/media"       # raw documents (weekly)
KEEP_LOCAL_DUMPS=3
WEEKLY_DAY=7                               # 1=Mon ... 7=Sun
# -----------------------------------------------------------------------------

# host-local overrides (NOT in git): /mnt/user/appdata/borg/backup.conf
# -> real values live there; deploys from git never clobber them
if [ -f "$RDIR/backup.conf" ]; then . "$RDIR/backup.conf"; fi

mkdir -p "$DUMP_DIR" "$RDIR/cache" "$RDIR/ssh"

ENV_ARGS=(
  -e "BORG_REPO=ssh://${SB_USER}@${SB_HOST}:23/${SB_REPO_PATH}"
  -e "BORG_PASSPHRASE=$(cat "$PASSFILE")"
  -e "BORG_RSH=ssh -i /root/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
  -e BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
  -e TZ=Europe/Berlin
)
VOL_ARGS=(
  -v "$RDIR/ssh:/root/.ssh"
  -v "$RDIR/cache:/root/.cache/borg"
  -v "$RDIR/exclude.txt:/etc/borg/exclude.txt:ro"
  -v "$APPDATA:/appdata:ro"
  -v "$DUMP_DIR:/dumps:ro"
  -v /boot/config:/bootconfig:ro
)
# mount media/export dirs explicitly (they may live OUTSIDE appdata) -
# only mount paths that exist, so docker doesn't create stray dirs
if [ -d "$IMMICH_LIBRARY" ];            then VOL_ARGS+=(-v "$IMMICH_LIBRARY:/immich-library:ro"); fi
if [ -d "$PAPERLESS_EXPORT_HOST_DIR" ]; then VOL_ARGS+=(-v "$PAPERLESS_EXPORT_HOST_DIR:/paperless-export:ro"); fi
if [ -d "$PAPERLESS_MEDIA_HOST" ];      then VOL_ARGS+=(-v "$PAPERLESS_MEDIA_HOST:/paperless-media:ro"); fi
borg(){ docker run --rm "${ENV_ARGS[@]}" "${VOL_ARGS[@]}" "$IMAGE" "$@"; }

log(){ echo "[$(date '+%F %T')] $*"; }
notify(){ [ -x /usr/local/emhttp/plugins/dynamix/scripts/notify ] && \
  /usr/local/emhttp/plugins/dynamix/scripts/notify -e borg-backup -s "borg: $1" -d "$2" -i "$3" || true; }
COMPLETED=0
trap 'if [ "$COMPLETED" -eq 0 ]; then notify ERROR "backup failed - check User Scripts log" warning; fi; exit 1' ERR

# ---------- 1) DB dumps / exports on the host (container has no docker access) -
TS=$(date +%F)
FAILURES=0
# dump to .part first: a failed pg_dumpall must not leave an empty file behind,
# and same-day re-runs must not collide (zstd -o refuses to overwrite)
dump_db(){  # $1=container  $2=db-user  $3=outfile
  local part="$3.part"
  rm -f "$part"
  if ! docker exec "$1" pg_dumpall -c -U "$2" | zstd -3 -q -f -o "$part"; then
    rm -f "$part"; return 1
  fi
  mv -f "$part" "$3"
}
# component failures are NON-FATAL: one broken app must not block the whole
# backup. Count them, continue, exit non-zero at the end.
if docker ps --format '{{.Names}}' | grep -qx "$IMMICH_DB_CONTAINER"; then
  log "dump immich DB"
  if ! dump_db "$IMMICH_DB_CONTAINER" "$IMMICH_DB_USER" "$DUMP_DIR/immich-$TS.sql.zst"; then
    log "WARNING: immich DB dump failed - continuing without it"
    FAILURES=$((FAILURES + 1))
  fi
fi
if docker ps --format '{{.Names}}' | grep -qx "$PAPERLESS_CONTAINER"; then
  log "paperless: online SQLite snapshot -> db.sqlite3"
  mkdir -p "$PAPERLESS_EXPORT_HOST_DIR"
  if ! docker exec "$PAPERLESS_CONTAINER" python -c "import sqlite3; s=sqlite3.connect('$PAPERLESS_DB_CONTAINER_PATH'); d=sqlite3.connect('$PAPERLESS_EXPORT_CONTAINER_PATH/db.sqlite3'); s.backup(d); d.close(); s.close()"; then
    log "WARNING: paperless DB snapshot failed - continuing without it"
    FAILURES=$((FAILURES + 1))
  fi
fi
# clean up legacy document_exporter zips (borg already holds everything offsite)
ls -t "$PAPERLESS_EXPORT_HOST_DIR"/export-*.zip 2>/dev/null | tail -n +$((KEEP_LOCAL_DUMPS + 1)) | xargs -r rm -f || true
ls -t "$DUMP_DIR"/*.sql.zst 2>/dev/null | tail -n +$((KEEP_LOCAL_DUMPS + 1)) | xargs -r rm -f || true

# ---------- 1b) repo check / auto-init (self-healing) -------------------------
if ! borg info >/dev/null 2>&1; then
  log "repo not found - initializing (borg init --encryption=repokey-blake2)"
  borg init --encryption=repokey-blake2
fi

# ---------- 2) daily: appdata configs + dumps + flash config + exports -------
DAILY_SRC=(/appdata /dumps /bootconfig)
if [ -d "$PAPERLESS_EXPORT_HOST_DIR" ]; then DAILY_SRC+=(/paperless-export); fi
log "borg create: daily (appdata configs, dumps, /boot/config, paperless exports)"
borg create --stats --compression zstd,3 --exclude-from /etc/borg/exclude.txt \
  "::daily-{now:%Y-%m-%d_%H-%M}" "${DAILY_SRC[@]}"
log "borg prune: daily"
borg prune --list --stats --glob-archives 'daily-*' --keep-daily 7 --keep-weekly 5 --keep-monthly 6
borg compact --stats >/dev/null 2>&1 || true    # borg >= 1.2, frees space after prune

# ---------- 3) weekly (Sunday): irreplaceable media + check ------------------
if [ "$(date +%u)" -eq "$WEEKLY_DAY" ]; then
  MEDIA=()
  [ -d "$IMMICH_LIBRARY" ]             && MEDIA+=(/immich-library)
  [ -d "$PAPERLESS_MEDIA_HOST" ]       && MEDIA+=(/paperless-media)
  if [ ${#MEDIA[@]} -gt 0 ]; then
    log "borg create: weekly media"
    borg create --stats --compression zstd,3 "::media-{now:%Y-%m-%d_%H-%M}" "${MEDIA[@]}"
    borg prune --list --stats --glob-archives 'media-*' --keep-weekly 8 --keep-monthly 12
    borg compact --stats >/dev/null 2>&1 || true
  fi
  log "borg check"
  borg check --info --stats
  # monthly deep check (slow, reads all data): borg check --verify-data
fi

log "done"
COMPLETED=1
if [ "$FAILURES" -gt 0 ]; then
  notify WARNING "backup finished but $FAILURES component(s) failed - check log" warning
  exit 1
fi
notify OK "backup finished" normal
